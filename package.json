{
  "name": "exec-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "通过 exec 在自己的机器上组合和执行工具的 MCP 服务。",
  "engines": {
    "node": "^20.19.0 || >=22.19.0 <26"
  },
  "bin": {
    "exec-mcp": "dist/src/cli.js"
  },
  "scripts": {
    "postinstall": "node scripts/fix-node-pty.mjs",
    "build:ui": "vite build",
    "build:server": "tsc -p tsconfig.build.json",
    "build": "npm run build:ui && npm run build:server",
    "typecheck:server": "tsc -p tsconfig.json --noEmit",
    "typecheck:ui": "tsc -p ui/tsconfig.json --noEmit",
    "typecheck": "npm run typecheck:server && npm run typecheck:ui",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build && npm run format:check",
    "dev": "tsx src/cli.ts",
    "start": "node dist/src/cli.js serve",
    "prepack": "npm run build",
    "test:package": "node scripts/package-smoke.mjs",
    "format": "prettier --write src test scripts *.ts *.json .github/workflows/*.yml ui/src/**/*.{ts,tsx,css}",
    "format:check": "prettier --check src test scripts *.ts *.json .github/workflows/*.yml ui/src/**/*.{ts,tsx,css}"
  },
  "dependencies": {
    "@grpc/grpc-js": "1.14.4",
    "@grpc/proto-loader": "0.8.1",
    "@iarna/toml": "2.2.5",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/core": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@openai/codex": "0.155.1",
    "acorn": "8.18.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "better-sqlite3": "12.9.0",
    "file-type": "21.3.4",
    "jose": "6.2.12",
    "minisearch": "7.2.0",
    "node-pty": "1.1.0",
    "toml-eslint-parser": "1.0.3",
    "undici": "7.29.1",
    "yaml": "2.9.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "20.19.43",
    "@types/prismjs": "1.26.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "lucide-react": "1.47.0",
    "prettier": "3.6.2",
    "prismjs": "1.30.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "selfsigned": "3.0.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "4.1.11"
  },
  "license": "UNLICENSED",
  "files": [
    "scripts/fix-node-pty.mjs",
    "dist/src",
    "proto",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "AGENTS.md",
    "ARCHITECTURE.md",
    "docs"
  ]
}
